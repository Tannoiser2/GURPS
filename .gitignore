.DS_Store
**/.DS_Store

# Local environment / secrets
.env
.env.*
!.env.example
backend/.env

# Local assistant/editor settings
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# Node / Vite
node_modules/
frontend/node_modules/
dist/
frontend/dist/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel

# Local adventure compiler audit exports (solo root, non data/)
/compiled_adventures/
!/data/compiled_adventures/

# Backup/debug delle avventure rigenerati dalle GitHub Actions (non versionare)
data/compiled_adventures/_backup_*/
data/compiled_adventures/_debug_pdf/
*.bak
.claude/worktrees/

# Materiale sorgente PDF (manuali GURPS + moduli avventura): fuori dal repo per
# leggerezza (lo ZIP/clone era ~450MB). Le avventure compilate sono in data/.
# I PDF generati dall'app (PDF/, data/.../*.pdf, catalogo) restano versionati.
/*.pdf
gurps_avventure/
