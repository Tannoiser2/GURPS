# Copia questo file come .env e inserisci le tue chiavi

# Provider Claude + Gemini
ANTHROPIC_API_KEY=your_anthropic_key_here
# Chiave Google AI Studio per la generazione immagini (https://aistudio.google.com/apikey)
GOOGLE_AI_STUDIO_KEY=your_google_ai_studio_key_here

# Provider ChatGPT (OpenAI) — alternativo a Claude+Gemini
OPENAI_API_KEY=your_openai_key_here

# ── IA Locale via LM Studio (gratis, offline) ─────────────────────────────────
# LM Studio espone un server OpenAI-compatibile: nessuna chiave cloud richiesta.
# 1) Carica un modello in LM Studio (consigliato per italiano+JSON: Qwen2.5-32B-Instruct)
# 2) Avvia il Local Server (tab Developer → Start Server)
# 3) Metti LMSTUDIO_ENABLED=1 e riavvia il backend
# NOTA: è un server LOCALE. In deploy cloud (Render/Railway) localhost NON esiste:
#       usalo in locale, oppure esponi LM Studio via tunnel e cambia LMSTUDIO_BASE_URL.
LMSTUDIO_ENABLED=0
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Identificativo del modello caricato in LM Studio (o lascia il placeholder: il
# server instrada comunque al modello attivo).
LMSTUDIO_MODEL=local-model
# La api_key è ignorata dal server LM Studio, ma l'SDK openai ne vuole una.
LMSTUDIO_API_KEY=lm-studio
# 1 = forza JSON mode nei turni Master (consigliato con modelli locali).
LMSTUDIO_JSON_MODE=1
# 1 = disattiva il "reasoning" dei modelli Qwen 3.x (soft switch /no_think).
# I modelli reasoning altrimenti "pensano" e possono restituire risposta vuota.
# Metti 0 solo se usi un modello che non capisce /no_think.
LMSTUDIO_NO_THINK=1
# Minimo di token di output per chiamata: i modelli reasoning "pensano" e con
# budget piccoli restituiscono vuoto. 3072 dà spazio a pensare + rispondere.
# Con un modello non-reasoning puoi abbassarlo (es. 1024) per andare più veloce.
LMSTUDIO_MIN_OUTPUT_TOKENS=3072
# Timeout secondi per chiamata (un 32B locale è lento): alza se il modello è grande.
LMSTUDIO_TIMEOUT=300

# ── Immagini locali via Stable Diffusion / ComfyUI (gratis, offline) ──────────
# ComfyUI espone un'API a workflow (default localhost:8188). Genera avatar, scene
# e mappe in locale invece delle API OpenAI/Gemini.
# 1) Avvia ComfyUI con un checkpoint SDXL caricato
# 2) Metti SD_ENABLED=1 e SD_COMFY_CHECKPOINT col nome esatto del tuo checkpoint
# 3) Riavvia il backend; nel gioco scegli "Locale (SD)" nel selettore immagini
# NOTA: server LOCALE → in deploy cloud non esiste; usalo in locale (o via tunnel).
SD_ENABLED=0
SD_COMFY_URL=http://localhost:8188
# Nome del checkpoint SDXL come appare in ComfyUI (CheckpointLoaderSimple).
SD_COMFY_CHECKPOINT=sd_xl_base_1.0.safetensors
# Parametri di campionamento (default sensati per SDXL).
SD_STEPS=26
SD_CFG=6.5
SD_SAMPLER=dpmpp_2m
SD_SCHEDULER=karras
# Timeout secondi per immagine (una scena SDXL può richiedere parecchio su GPU lente).
SD_TIMEOUT=180

# ── Import PDF ────────────────────────────────────────────────────────────────
# IMPORTANTE: tienilo a 1. Senza, l'estrazione usa solo le regex e produce
# pochissimi indizi/NPC (il problema "1 indizio").
GURPS_ENABLE_LLM_EXTRACTORS=1
PDF_COMPILE_MAX_WORKERS=1

# ── OCR (PDF con text-layer corrotto/da scansione) ────────────────────────────
# 0 = OCR off (import veloce, consigliato). Alza a 8 per i PDF illeggibili.
# Richiede il binario tesseract:  macOS → brew install tesseract tesseract-lang
OCR_MAX_PAGES=0
# OCR_DPI=150
# OCR_TIME_BUDGET_S=120

# ── Opzionali ─────────────────────────────────────────────────────────────────
# PDF_COLUMN_AWARE=1   # 0 = disattiva il de-interleaving delle colonne
